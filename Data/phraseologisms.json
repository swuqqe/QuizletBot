[
  {
    "text": "Авгієві стайні",
    "explanation": "щось дуже занедбане, повне безладдя.",
    "id": 1
  },
  {
    "text": "Аж іскри летять",
    "explanation": "дуже енергійно, завзято, запально, докладаючи всіх зусиль.",
    "id": 2
  },
  {
    "text": "Азбучна істина",
    "explanation": "загальнозрозуміла елементарна річ.",
    "id": 3
  },
  {
    "text": "Альфа й омега",
    "explanation": "початок і кінець чого-небудь.",
    "id": 4
  },
  {
    "text": "Аріаднина нитка",
    "explanation": "те, що дає правильний напрямок, допомагає знайти правильний вихід з якоїсь ситуації.",
    "id": 5
  },
  {
    "text": "Ахіллесова п'ята",
    "explanation": "дошкульне місце, вразлива сторона кого-, чого-небудь.",
    "id": 6
  },
  {
    "text": "Бабине літо",
    "explanation": "погідні дні на початку осені; павутиння, що літає в цей період.",
    "id": 7
  },
  {
    "text": "Бентежити кров",
    "explanation": "збуджувати когось.",
    "id": 8
  },
  {
    "text": "Бити байдики",
    "explanation": "бути без діла, весело проводити час.",
    "id": 9
  },
  {
    "text": "Бити в хвіст і в гриву",
    "explanation": "дуже сильно діяти.",
    "id": 10
  },
  {
    "text": "Білими нитками шитий",
    "explanation": "невміло, погано замаскований, виконаний.",
    "id": 11
  },
  {
    "text": "Брати в свої руки",
    "explanation": "підкоряти кого-небудь своїй волі; керувати кимсь.",
    "id": 12
  },
  {
    "text": "Брати в шори",
    "explanation": "підкоряти кого-небудь своїй волі, примушувати коритися.",
    "id": 13
  },
  {
    "text": "Бувати в бувальцях",
    "explanation": "багато бачити, зазнавати в житті.",
    "id": 14
  },
  {
    "text": "Варити воду",
    "explanation": "знущатися з кого-небудь, показувати свої примхи, вередуючи перед ким-небудь, висуваючи надмірні вимоги або прискіпуючись до когось.",
    "id": 15
  },
  {
    "text": "Виводити з рівноваги",
    "explanation": "позбавляти душевного спокою, порушувати нормальний ритм життя, роботи.",
    "id": 16
  },
  {
    "text": "Виводити на чисту воду",
    "explanation": "викривати чию-небудь непорядність, підступність, нечесність.",
    "id": 17
  },
  {
    "text": "Видно пана по халявах",
    "explanation": "людина розкривається в її поведінці.",
    "id": 18
  },
  {
    "text": "Вийти в люди",
    "explanation": "домогтися певного становища в суспільстві.",
    "id": 19
  },
  {
    "text": "Викинути з голови",
    "explanation": "перестати думати про кого-, що-небудь, забути когось, щось.",
    "id": 20
  },
  {
    "text": "Вискочити на сухе",
    "explanation": "уникнути заслуженого покарання, осуду.",
    "id": 21
  },
  {
    "text": "Вислизнути з рук",
    "explanation": "поступово зникати, зменшуватися, втрачатися.",
    "id": 22
  },
  {
    "text": "Високо літати",
    "explanation": "посідати високе становище.",
    "id": 23
  },
  {
    "text": "Вити вовком",
    "explanation": "бути у стані великого розпачу.",
    "id": 24
  },
  {
    "text": "Витикати носа",
    "explanation": "вийти звідкись або покинути щось.",
    "id": 25
  },
  {
    "text": "Вичитувати мораль",
    "explanation": "дорікаючи, давати комусь настанови, поради.",
    "id": 26
  },
  {
    "text": "Відкривати шлях",
    "explanation": "створювати сприятливі умови для досягнення успіху в чому-небудь.",
    "id": 27
  },
  {
    "text": "Відкрити душу",
    "explanation": "відверто, щиросердно ділитися з ким-небудь своїми заповітними думками, переживаннями, намірами.",
    "id": 28
  },
  {
    "text": "Вітер у голові грає",
    "explanation": "хто-небудь легковажний, несерйозний.",
    "id": 29
  },
  {
    "text": "Води не замутить",
    "explanation": "дуже лагідний, скромний, сумирний.",
    "id": 30
  },
  {
    "text": "Водити за ніс",
    "explanation": "обдурювати кого-небудь певний час, не виконуючи обіцяного або приховуючи щось.",
    "id": 31
  },
  {
    "text": "Ганяти собак",
    "explanation": "не працювати, нічого не робити; байдикувати.",
    "id": 32
  },
  {
    "text": "Гаряча голова",
    "explanation": "запальна, нестримна людина.",
    "id": 33
  },
  {
    "text": "Геростратова слава",
    "explanation": "слава, яка була отримана злочинним шляхом або не хорошими вчинками.",
    "id": 34
  },
  {
    "text": "Гладити по голові",
    "explanation": "хвалити, заохочувати.",
    "id": 35
  },
  {
    "text": "Гнути кирпу",
    "explanation": "гордовито триматися, бути чванливим, гонористим; зазнаватися.",
    "id": 36
  },
  {
    "text": "Гнути коліна",
    "explanation": "виражати покірність; запобігати перед ким-небудь, підлещуватися до когось.",
    "id": 37
  },
  {
    "text": "Голки не підточиш",
    "explanation": "дуже якісно, так, щоб не було претензій.",
    "id": 38
  },
  {
    "text": "Голову гризти",
    "explanation": "набридати розмовами.",
    "id": 39
  },
  {
    "text": "Грати на нервах",
    "explanation": "дратувати, дражнити кого-небудь, навмисне спричиняти переживання комусь.",
    "id": 40
  },
  {
    "text": "Грати очима",
    "explanation": "грайливо поглядати на когось, прагнучи звернути на себе увагу, викликати інтерес до себе.",
    "id": 41
  },
  {
    "text": "Грати першу скрипку",
    "explanation": "бути головним у якій-небудь справі.",
    "id": 42
  },
  {
    "text": "Гріти чуба",
    "explanation": "витрачати багато сил і енергії, старанно виконуючи якусь роботу; тяжко, виснажливо працювати.",
    "id": 43
  },
  {
    "text": "Давати прочухана",
    "explanation": "дуже лаяти кого-небудь.",
    "id": 44
  },
  {
    "text": "Далеко куцому до зайця",
    "explanation": "велика різниця між ким-небудь.",
    "id": 45
  },
  {
    "text": "Дамоклів меч",
    "explanation": "небезпека або неприємність, що постійно загрожує комусь.",
    "id": 46
  },
  {
    "text": "Дати відкоша",
    "explanation": "не погоджуватися виходити заміж чи зустрічатися з кимсь; відмовляти кому-небудь у сватанні, залицянні.",
    "id": 47
  },
  {
    "text": "До нових віників",
    "explanation": "надовго.",
    "id": 48
  },
  {
    "text": "До сьомого поту",
    "explanation": "дуже виснажливо, понад силу; тяжко.",
    "id": 49
  },
  {
    "text": "Еолова арфа",
    "explanation": "душа людини, яка відгукується на всі події життя.",
    "id": 50
  },
  {
    "text": "Жовтороте пташеня",
    "explanation": "про недосвідчену людину.",
    "id": 51
  },
  {
    "text": "З доброго дива",
    "explanation": "невідомо чому, чомусь, без будь-якої причини.",
    "id": 52
  },
  {
    "text": "З душі верне",
    "explanation": "який відвертає від себе; осоружний.",
    "id": 53
  },
  {
    "text": "З молоком на губах",
    "explanation": "хтось дуже молодий, неповнолітній, недосвідчений.",
    "id": 54
  },
  {
    "text": "З притиском",
    "explanation": "твердо, категорично, суворо, незадоволено.",
    "id": 55
  },
  {
    "text": "За версту почути",
    "explanation": "відразу можна розпізнати, відрізнити від інших кого-, що-небудь.",
    "id": 56
  },
  {
    "text": "За всяку ціну",
    "explanation": "обов'язково, неодмінно, за всіляких умов, обставин, незважаючи на будь-які труднощі чи перешкоди.",
    "id": 57
  },
  {
    "text": "За милу душу",
    "explanation": "охоче, з дуже великим задоволенням.",
    "id": 58
  },
  {
    "text": "За тридев'ять земель",
    "explanation": "дуже далеко.",
    "id": 59
  },
  {
    "text": "Заварити кашу",
    "explanation": "затіяти щось дуже складне, клопітне, що загрожує неприємними наслідками.",
    "id": 60
  },
  {
    "text": "Задирати голову",
    "explanation": "триматися гордовито, зазнаватися, величатися, ставати зарозумілим.",
    "id": 61
  },
  {
    "text": "Задирати носа",
    "explanation": "гордовито триматися, бути чванливим, гонористим; зазнаватися.",
    "id": 62
  },
  {
    "text": "Закрутити веремію",
    "explanation": "здіймати колотнечу, спричиняти неспокій; галасувати, вередувати, навмисне шукати причину для сварки, скандалу.",
    "id": 63
  },
  {
    "text": "Зарубати на носі",
    "explanation": "добре, надовго запам'ятати.",
    "id": 64
  },
  {
    "text": "Заходити збоку",
    "explanation": "говорити про суть справи натяками, репліками.",
    "id": 65
  },
  {
    "text": "Збиватися з ніг",
    "explanation": "дуже втомитися, набігавшись, находившись або від різних клопотів.",
    "id": 66
  },
  {
    "text": "Збігло за водою",
    "explanation": "непомітно і безповоротно зникло щось.",
    "id": 67
  },
  {
    "text": "Земля обітована",
    "explanation": "місце заповітної мрії.",
    "id": 68
  },
  {
    "text": "Зі шкури пнутися",
    "explanation": "старатися з усіх сил.",
    "id": 69
  },
  {
    "text": "Знати, де раки зимують",
    "explanation": "маючи неабиякий досвід, уміти добре розбиратися в ситуації; бути хитрим, спритним.",
    "id": 70
  },
  {
    "text": "Золота молодь",
    "explanation": "розбещені діти багатих батьків.",
    "id": 71
  },
  {
    "text": "Зривати личину",
    "explanation": "показувати справжню сутність когось, чогось.",
    "id": 72
  },
  {
    "text": "Зривати маску",
    "explanation": "викривати кого-небудь, показуючи його справжню сутність, істинні наміри.",
    "id": 73
  },
  {
    "text": "І води не замутить",
    "explanation": "дуже лагідний, скромний, сумирний.",
    "id": 74
  },
  {
    "text": "І кінці в воду",
    "explanation": "не залишати ніяких слідів злочину, негідного вчинку.",
    "id": 75
  },
  {
    "text": "І кіт не валявся",
    "explanation": "хто-небудь ще нічого не робив.",
    "id": 76
  },
  {
    "text": "Комар носа не підточить",
    "explanation": "не буде до чого причепитися, прискіпатися.",
    "id": 77
  },
  {
    "text": "Купа на купі",
    "explanation": "у великій кількості.",
    "id": 78
  },
  {
    "text": "Купатися в золоті",
    "explanation": "жити в багатстві, щасливо, мати всього вдосталь.",
    "id": 79
  },
  {
    "text": "Лепта вдовиці",
    "explanation": "невеликий, посильний вклад.",
    "id": 80
  },
  {
    "text": "Ловити ґав",
    "explanation": "марно витрачати час, нічим не займатися; байдикувати.",
    "id": 81
  },
  {
    "text": "Ловити кожне слово",
    "explanation": "дуже уважно, з цікавістю слухати когось.",
    "id": 82
  },
  {
    "text": "Ловити кожну мить",
    "explanation": "раціонально використовувати час; дорожити часом.",
    "id": 83
  },
  {
    "text": "Ловити момент",
    "explanation": "використовувати слушну нагоду; не упускати якоїсь можливості.",
    "id": 84
  },
  {
    "text": "Милити чуба",
    "explanation": "робити зауваження, дорікати кому-небудь за щось; лаяти, картати за щось.",
    "id": 85
  },
  {
    "text": "Міцний горішок",
    "explanation": "людина зі складним характером.",
    "id": 86
  },
  {
    "text": "Мов з гуски вода",
    "explanation": "хто-небудь зовсім не реагує на щось; ніщо не впливає, не діє на когось.",
    "id": 87
  },
  {
    "text": "Мов на світ народився",
    "explanation": "хто-небудь відчуває душевний спокій після страждань, переживань, фізичних мук.",
    "id": 88
  },
  {
    "text": "Мозолити руки",
    "explanation": "займатися фізичною працею; працювати.",
    "id": 89
  },
  {
    "text": "Море по коліно",
    "explanation": "хтось нічого не боїться, ніщо не лякає кого-небудь; не страшно комусь.",
    "id": 90
  },
  {
    "text": "Мороз пробирає по спині",
    "explanation": "комусь стає холодно.",
    "id": 91
  },
  {
    "text": "Мотати на вус",
    "explanation": "придивлятися, прислухатися до чого-небудь; помічати.",
    "id": 92
  },
  {
    "text": "Мухи не зобидить",
    "explanation": "хто-небудь дуже добрий, сумирний, лагідний.",
    "id": 93
  },
  {
    "text": "На все горло",
    "explanation": "дуже голосно.",
    "id": 94
  },
  {
    "text": "На всю губу",
    "explanation": "великий, значний; заможний, багатий.",
    "id": 95
  },
  {
    "text": "На живу нитку",
    "explanation": "як-небудь, аби було з'єднане докупи, щоб не розпалося.",
    "id": 96
  },
  {
    "text": "На рівному місці",
    "explanation": "без якихось видимих причин, безпідставно.",
    "id": 97
  },
  {
    "text": "На чистоту",
    "explanation": "прямолінійно, щиро, відверто.",
    "id": 98
  },
  {
    "text": "Набити собі руку",
    "explanation": "набути досвіду, уміння, вправності, майстерності в чому-небудь.",
    "id": 99
  },
  {
    "text": "Нагуляти жиру",
    "explanation": "поправлятися, товстіти.",
    "id": 100
  },
  {
    "text": "Надягати машкару",
    "explanation": "приховувати свою справжню сутність.",
    "id": 101
  },
  {
    "text": "Накрити мокрим рядном",
    "explanation": "вилаяти когось або різко висловити своє незадоволення, сказати щось неприємне.",
    "id": 102
  },
  {
    "text": "Намотати на вус",
    "explanation": "запам'ятовувати, брати до уваги що-небудь.",
    "id": 103
  },
  {
    "text": "Наріжний камінь",
    "explanation": "основа, базис.",
    "id": 104
  },
  {
    "text": "Не в тім'я битий",
    "explanation": "розумний, тямущий, кмітливий.",
    "id": 105
  },
  {
    "text": "Не відривати очей",
    "explanation": "весь час, уважно, пильно дивитися на кого-, що-небудь, стежити за ким або чимсь; милуватися ким-, чим-небудь.",
    "id": 106
  },
  {
    "text": "Не за горами",
    "explanation": "на невеликій відстані; недалеко, близько; у найближчому майбутньому, незабаром, скоро.",
    "id": 107
  },
  {
    "text": "Не йти з думки",
    "explanation": "мати нав'язливу думку, хто-небудь не може забути, постійно думає, згадує про когось, щось.",
    "id": 108
  },
  {
    "text": "Не показувати очей",
    "explanation": "не приходити, не з'являтися куди-небудь, до когось.",
    "id": 109
  },
  {
    "text": "Не чути землі під собою",
    "explanation": "бути в надзвичайно піднесеному стані; дуже швидко, енергійно.",
    "id": 110
  },
  {
    "text": "Невелике цабе",
    "explanation": "особа, що не займає високої посади, не має ніякого впливу в суспільстві, в колективі.",
    "id": 111
  },
  {
    "text": "Неопалима купина",
    "explanation": "те, що живе вічно.",
    "id": 112
  },
  {
    "text": "Ні вдень ні вночі",
    "explanation": "ніколи.",
    "id": 113
  },
  {
    "text": "Ні гаряче ні зимно",
    "explanation": "байдуже.",
    "id": 114
  },
  {
    "text": "Ні кілка ні дрючка",
    "explanation": "нічого.",
    "id": 115
  },
  {
    "text": "Ні пари з вуст",
    "explanation": "нічого не говорити, затято мовчати.",
    "id": 116
  },
  {
    "text": "Ні світ ні зоря",
    "explanation": "рано.",
    "id": 117
  },
  {
    "text": "Ні сіло ні впало",

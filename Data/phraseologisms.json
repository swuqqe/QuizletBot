  },
  {
    "text": "Рвати горло",
    "explanation": "дуже кричати, галасувати.",
    "id": 155
  },
  {
    "text": "Рвати руки",
    "explanation": "дуже важко, багато з надмірним напруженням, над силу працювати.",
    "id": 156
  },
  {
    "text": "Розкривати карти",
    "explanation": "переставати приховувати свої (або чиїсь) плани, наміри тощо; починати діяти відкрито.",
    "id": 157
  },
  {
    "text": "Розуму не позичати",
    "explanation": "хто-небудь дуже розумний, тямущий.",
    "id": 158
  },
  {
    "text": "Рота не розкрити",
    "explanation": "мовчати, нічого не говорити.",
    "id": 159
  },
  {
    "text": "Руки загребущі",
